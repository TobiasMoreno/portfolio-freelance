    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.1",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3"
  }
